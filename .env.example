# OpenAI API Configuration
# Replace with your OpenAI API key - for CVS interview project
OPENAI_API_KEY=your_openai_api_key_here

# PDF Settings
PDF_URL=https://www.aetnabetterhealth.com/content/dam/aetna/medicaid/illinois/pdf/ABHIL_Member_Handbook.pdf
PDF_LOCAL_PATH=./data/pdf/ABHIL_Member_Handbook.pdf

# Vector Database Settings
VECTOR_DB_PATH=./data/vector_db

# LLM Settings
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600

# Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
